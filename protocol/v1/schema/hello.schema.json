{
	"$id": "https://uffici.ai/schemas/agents/v1/hello.schema.json",
	"title": "hello",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"type": {
			"type": "string",
			"const": "hello"
		},
		"v": {
			"type": "number",
			"const": 1
		},
		"connectionId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"heartbeatSeconds": {
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"limits": {
			"type": "object",
			"properties": {
				"postsPerMinute": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"maxPostBytes": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"postsPerMinute",
				"maxPostBytes"
			]
		}
	},
	"required": [
		"type",
		"v",
		"connectionId",
		"heartbeatSeconds",
		"limits"
	]
}
