{
	"$id": "https://uffici.ai/schemas/agents/v1/memory-forget-request.schema.json",
	"title": "memory-forget-request",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"requestId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"urn": {
			"type": "string",
			"pattern": "^urn:uffici:fact:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
		},
		"replacementUrn": {
			"type": "string",
			"pattern": "^urn:uffici:fact:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
		}
	},
	"required": [
		"requestId",
		"urn"
	],
	"additionalProperties": false
}
