{
	"$id": "https://uffici.ai/schemas/agents/v1/transfer-response.schema.json",
	"title": "transfer-response",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"op": {
			"type": "string",
			"enum": [
				"download",
				"upload"
			]
		},
		"jti": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"grant": {
			"type": "string",
			"minLength": 1,
			"maxLength": 4096
		},
		"expiresAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
		},
		"callUrn": {
			"type": "string",
			"pattern": "^urn:uffici:tool_call:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
		},
		"file": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 255
				},
				"size": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"contentType": {
					"type": "string",
					"maxLength": 127,
					"pattern": "^[\\w.+-]+\\/[\\w.+-]+$"
				},
				"crc32c": {
					"type": "string",
					"pattern": "^[A-Za-z0-9+/]{6}==$"
				}
			},
			"required": [
				"name",
				"size"
			]
		}
	},
	"required": [
		"op",
		"jti",
		"grant",
		"expiresAt",
		"callUrn",
		"file"
	]
}
