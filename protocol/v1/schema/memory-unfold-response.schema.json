{
	"$id": "https://uffici.ai/schemas/agents/v1/memory-unfold-response.schema.json",
	"title": "memory-unfold-response",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"urn": {
			"type": "string",
			"minLength": 1,
			"maxLength": 200
		},
		"supersededBy": {
			"anyOf": [
				{
					"type": "null"
				},
				{
					"type": "object",
					"properties": {
						"visible": {
							"type": "boolean",
							"const": true
						},
						"urn": {
							"type": "string",
							"minLength": 1,
							"maxLength": 200
						}
					},
					"required": [
						"visible",
						"urn"
					]
				},
				{
					"type": "object",
					"properties": {
						"visible": {
							"type": "boolean",
							"const": false
						}
					},
					"required": [
						"visible"
					]
				}
			]
		},
		"rows": {
			"maxItems": 20,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"urn": {
						"type": "string",
						"minLength": 1,
						"maxLength": 200
					},
					"level": {
						"type": "string",
						"enum": [
							"conversation",
							"folder",
							"organization"
						]
					},
					"text": {
						"type": "string"
					},
					"at": {
						"type": "string"
					},
					"depth": {
						"type": "integer",
						"minimum": 1,
						"maximum": 2
					},
					"supersededKind": {
						"type": "string",
						"enum": [
							"revision",
							"synthesis"
						]
					},
					"source": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"enum": [
											"remembered",
											"member_written"
										]
									}
								},
								"required": [
									"kind"
								]
							},
							{
								"type": "null"
							}
						]
					}
				},
				"required": [
					"urn",
					"level",
					"text",
					"at",
					"depth",
					"supersededKind",
					"source"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"urn",
		"supersededBy",
		"rows"
	]
}
