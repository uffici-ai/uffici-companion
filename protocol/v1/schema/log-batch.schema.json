{
	"$id": "https://uffici.ai/schemas/agents/v1/log-batch.schema.json",
	"title": "log-batch",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"client": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"version": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"harnessKind": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"harnessVersion": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"pluginVersion": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				}
			},
			"required": [
				"name",
				"version"
			],
			"additionalProperties": false
		},
		"entries": {
			"minItems": 1,
			"maxItems": 500,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"ts": {
						"type": "string",
						"format": "date-time",
						"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
					},
					"source": {
						"type": "string",
						"enum": [
							"companion",
							"plugin",
							"harness"
						]
					},
					"level": {
						"type": "string",
						"enum": [
							"debug",
							"info",
							"warn",
							"error"
						]
					},
					"logger": {
						"type": "string",
						"maxLength": 128
					},
					"message": {
						"type": "string",
						"maxLength": 8192
					},
					"attrs": {
						"type": "string",
						"maxLength": 4096
					},
					"redactions": {
						"type": "integer",
						"minimum": 0,
						"maximum": 100000
					}
				},
				"required": [
					"ts",
					"source",
					"level",
					"message"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"client",
		"entries"
	],
	"additionalProperties": false
}
