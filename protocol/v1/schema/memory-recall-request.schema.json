{
	"$id": "https://uffici.ai/schemas/agents/v1/memory-recall-request.schema.json",
	"title": "memory-recall-request",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"requestId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"query": {
			"type": "string",
			"minLength": 1,
			"maxLength": 8000
		},
		"limit": {
			"type": "integer",
			"minimum": 1,
			"maximum": 20
		},
		"deadlineMs": {
			"type": "integer",
			"minimum": 1250,
			"maximum": 10000
		}
	},
	"required": [
		"requestId",
		"query"
	],
	"additionalProperties": false
}
