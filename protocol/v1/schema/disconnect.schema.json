{
	"$id": "https://uffici.ai/schemas/agents/v1/disconnect.schema.json",
	"title": "disconnect",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"type": {
			"type": "string",
			"const": "disconnect"
		},
		"v": {
			"type": "number",
			"const": 1
		},
		"reason": {
			"type": "string",
			"enum": [
				"instance_conflict",
				"key_revoked",
				"ticket_expired",
				"server_shutdown",
				"idle",
				"protocol_error"
			]
		},
		"instruction": {
			"type": "string",
			"minLength": 1
		}
	},
	"required": [
		"type",
		"v",
		"reason",
		"instruction"
	]
}
