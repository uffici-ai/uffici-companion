{
	"$id": "https://uffici.ai/schemas/agents/v1/memory-forget-response.schema.json",
	"title": "memory-forget-response",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"urn": {
			"type": "string",
			"pattern": "^urn:uffici:fact:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
		},
		"supersededBy": {
			"type": "string",
			"minLength": 1,
			"maxLength": 200
		}
	},
	"required": [
		"urn",
		"supersededBy"
	]
}
