{
	"$id": "https://uffici.ai/schemas/agents/v1/release.schema.json",
	"title": "release",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"type": {
			"type": "string",
			"const": "release"
		},
		"v": {
			"type": "number",
			"const": 1
		},
		"conversationId": {
			"type": "string",
			"format": "uuid",
			"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
		},
		"reason": {
			"type": "string",
			"enum": [
				"pass_ended",
				"archived",
				"deleted"
			]
		}
	},
	"required": [
		"type",
		"v",
		"conversationId",
		"reason"
	]
}
